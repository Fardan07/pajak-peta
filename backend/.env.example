PORT=5000
# Kosongkan DATABASE_URL jika ingin menggunakan Zero-Config In-Memory Fallback
DATABASE_URL=postgresql://username:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# PIN Otorisasi Portal Sinkronisasi Dinas (Ubah saat di-hosting ke produksi)
ADMIN_PIN=2026
# Daftar domain frontend yang diizinkan mengakses API (pisahkan dengan koma, atau kosongkan untuk mengizinkan semua)
CORS_ORIGIN=
